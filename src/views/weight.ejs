<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Unit Converter</title>
</head>

<body>
    <main>
        <%- include('partials/header') -%>
            <%- include('partials/nav') -%>

                <% if (result !==undefined) { %>

                    <section>
                        <h2>Result</h2>
                        <p>
                            <%= weight %>
                                <%= convertFrom %> = <%= result %>
                                        <%= convertTo %>
                        </p>
                    </section>

                    <% } else { %>

                        <form action="/weight" method="post">
                            <fieldset>
                                <dl class="weight">
                                    <dt>
                                        <label for="weight">Enter the weight to convert</label>
                                    </dt>
                                    <dd>
                                        <input type="text" id="weight" name="weight">
                                    </dd>
                                </dl>

                                <dl class="convertFrom">
                                    <dt>
                                        <label for="convertFrom">Unit to convert from</label>
                                    </dt>
                                    <dd>
                                        <select id="convertFrom" name="convertFrom">
                                            <option>milligram</option>
                                            <option>gram</option>
                                            <option>kilogram</option>
                                            <option>ounce</option>
                                            <option>pound</option>
                                        </select>
                                    </dd>
                                </dl>

                                <dl class="convertTo">
                                    <dt>
                                        <label for="convertTo">Unit to convert to</label>
                                    </dt>
                                    <dd>
                                        <select id="convertTo" name="convertTo">
                                            <option>milligram</option>
                                            <option>gram</option>
                                            <option>kilogram</option>
                                            <option>ounce</option>
                                            <option>pound</option>
                                        </select>
                                    </dd>
                                </dl>

                                <button type="submit">Convert</button>
                            </fieldset>
                        </form>

                        <% } %>
    </main>
</body>

</html>